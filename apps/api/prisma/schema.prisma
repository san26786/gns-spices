// GNS Spices — core schema
// Matches the architecture design in docs. Start with the tables needed for
// auth, catalog, pricing, cart, and orders; RFQ + private-label + inventory
// are in the file too so a single migration gets the whole shape.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// ────────────────────────── Identity ──────────────────────────

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.Citext
  phone            String?   @db.VarChar(24)
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  firstName        String?   @map("first_name") @db.VarChar(80)
  lastName         String?   @map("last_name") @db.VarChar(80)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz
  phoneVerifiedAt  DateTime? @map("phone_verified_at") @db.Timestamptz
  mfaSecret        String?   @map("mfa_secret") @db.VarChar(64)
  defaultRegion    String    @default("GB") @map("default_region") @db.Char(2)
  defaultCurrency  String    @default("GBP") @map("default_currency") @db.Char(3)
  status           UserStatus @default(active)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  memberships      BusinessMember[]
  staffRole        StaffRole?
  addresses        Address[]        @relation("UserAddresses")
  carts            Cart[]
  orders           Order[]
  refreshTokens    RefreshToken[]
  rfqs             Rfq[]
  plRequests       PrivateLabelRequest[]

  @@index([status], map: "users_status_idx")
  @@map("users")
}

enum UserStatus {
  active
  suspended
  deleted
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(128)
  familyId   String   @map("family_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  replacedBy String?  @map("replaced_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  userAgent  String?  @map("user_agent")
  ip         String?  @db.VarChar(64)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model BusinessProfile {
  id               String    @id @default(uuid()) @db.Uuid
  legalName        String    @map("legal_name") @db.VarChar(200)
  tradeName        String?   @map("trade_name") @db.VarChar(200)
  businessType     BusinessType @map("business_type")
  tier             BusinessTier @default(retail)
  taxId            String?   @map("tax_id") @db.VarChar(64)
  taxCountry       String    @map("tax_country") @db.Char(2)
  creditLimit      Decimal   @default(0) @map("credit_limit") @db.Decimal(14, 2)
  creditCurrency   String    @default("GBP") @map("credit_currency") @db.Char(3)
  paymentTermsDays Int       @default(0) @map("payment_terms_days")
  status           BusinessStatus @default(pending_verification)
  assignedAmId     String?   @map("assigned_am_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  members          BusinessMember[]
  customPriceLists PriceList[]
  carts            Cart[]
  orders           Order[]
  rfqs             Rfq[]
  plRequests       PrivateLabelRequest[]

  @@index([tier, status])
  @@index([assignedAmId])
  @@map("business_profiles")
}

enum BusinessType {
  restaurant
  distributor
  retailer
  manufacturer
  other
}

enum BusinessTier {
  retail
  wholesale
  distributor
  custom
}

enum BusinessStatus {
  pending_verification
  active
  suspended
}

model BusinessMember {
  businessId String @map("business_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  role       BusinessRole
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([businessId, userId])
  @@map("business_members")
}

enum BusinessRole {
  owner
  buyer
  approver
  viewer
}

model StaffRole {
  userId String @id @map("user_id") @db.Uuid
  role   StaffRoleType

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_roles")
}

enum StaffRoleType {
  super_admin
  ops
  support
  finance
  content
  pl_manager
}

model Address {
  id             String    @id @default(uuid()) @db.Uuid
  ownerType      AddressOwnerType @map("owner_type")
  ownerId        String    @map("owner_id") @db.Uuid
  label          String?   @db.VarChar(40)
  contactName    String?   @map("contact_name") @db.VarChar(120)
  phone          String?   @db.VarChar(24)
  line1          String    @db.VarChar(200)
  line2          String?   @db.VarChar(200)
  city           String    @db.VarChar(120)
  state          String?   @db.VarChar(120)
  postcode       String?   @db.VarChar(24)
  country        String    @db.Char(2)
  isDefaultShip  Boolean   @default(false) @map("is_default_ship")
  isDefaultBill  Boolean   @default(false) @map("is_default_bill")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // These are informational only — we don't enforce via FK because owner can be user or business.
  user        User? @relation("UserAddresses", fields: [ownerId], references: [id], map: "addr_user_fk")
  billingOrders  Order[] @relation("OrderBilling")
  shippingOrders Order[] @relation("OrderShipping")

  @@index([ownerType, ownerId])
  @@map("addresses")
}

enum AddressOwnerType {
  user
  business
}

// ────────────────────────── Catalog ──────────────────────────

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  parentId String?   @map("parent_id") @db.Uuid
  slug     String    @unique @db.VarChar(120)
  name     String    @db.VarChar(120)
  position Int       @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique @db.VarChar(160)
  skuRoot       String    @unique @map("sku_root") @db.VarChar(40)
  name          String    @db.VarChar(200)
  shortDesc     String?   @map("short_desc") @db.VarChar(500)
  longDesc      String?   @map("long_desc")
  categoryId    String?   @map("category_id") @db.Uuid
  brand         String    @default("GNS") @db.VarChar(80)
  originCountry String?   @map("origin_country") @db.Char(2)
  isB2bOnly     Boolean   @default(false) @map("is_b2b_only")
  isActive      Boolean   @default(true) @map("is_active")
  hsCode        String?   @map("hs_code") @db.VarChar(16)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  category  Category?          @relation(fields: [categoryId], references: [id])
  variants  ProductVariant[]
  media     ProductMedia[]
  regions   ProductRegionData[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sku          String   @unique @db.VarChar(64)
  /// Optional human label, e.g. "Chef's Reserve · 100g". Shown on labels and in the pack picker.
  label        String?  @db.VarChar(120)
  weightGrams  Int      @map("weight_grams")
  packaging    Packaging
  /// GS1 GTIN (EAN-13) once assigned. When set, the printed barcode is EAN-13; otherwise Code 128 of `sku`.
  barcode      String?  @db.VarChar(32)
  netWeightG   Int?     @map("net_weight_g")
  grossWeightG Int?     @map("gross_weight_g")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  media           ProductMedia[]
  priceListItems  PriceListItem[]
  inventoryLevels InventoryLevel[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  rfqItems        RfqItem[]
  priceRules      PriceRule[]

  @@index([productId])
  @@map("product_variants")
}

enum Packaging {
  pouch
  jar
  tin
  sack
  drum
}

model ProductMedia {
  id        String     @id @default(uuid()) @db.Uuid
  productId String?    @map("product_id") @db.Uuid
  variantId String?    @map("variant_id") @db.Uuid
  kind      MediaKind
  s3Key     String     @map("s3_key") @db.VarChar(500)
  altText   String?    @map("alt_text") @db.VarChar(200)
  position  Int        @default(0)

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("product_media")
}

enum MediaKind {
  image
  video
  doc
}

model ProductRegionData {
  productId       String  @map("product_id") @db.Uuid
  region          String  @db.Char(2)
  isAvailable     Boolean @default(true) @map("is_available")
  displayName     String? @map("display_name") @db.VarChar(200)
  ingredients     String?
  allergenInfo    String? @map("allergen_info")
  nutrition       Json?   @db.JsonB
  certifications  String[] @db.Text
  labelingLang    String  @default("en") @map("labeling_lang") @db.Char(2)
  importNotes     String? @map("import_notes")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, region])
  @@index([region, isAvailable])
  @@map("product_region_data")
}

// ────────────────────────── Pricing ──────────────────────────

model PriceList {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(40)
  name        String      @db.VarChar(120)
  region      String      @db.Char(2)
  currency    String      @db.Char(3)
  tier        BusinessTier
  businessId  String?     @map("business_id") @db.Uuid
  validFrom   DateTime    @default(now()) @map("valid_from") @db.Timestamptz
  validTo     DateTime?   @map("valid_to") @db.Timestamptz
  isActive    Boolean     @default(true) @map("is_active")

  business BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    PriceListItem[]
  rules    PriceRule[]

  @@index([businessId])
  @@index([region, tier, isActive])
  @@map("price_lists")
}

model PriceListItem {
  priceListId String  @map("price_list_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 4)
  minQty      Int     @default(1) @map("min_qty")

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([priceListId, variantId, minQty])
  @@map("price_list_items")
}

model PriceRule {
  id            String       @id @default(uuid()) @db.Uuid
  priceListId   String       @map("price_list_id") @db.Uuid
  variantId     String?      @map("variant_id") @db.Uuid
  minQty        Int          @map("min_qty")
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(14, 4)
  validFrom     DateTime?    @map("valid_from") @db.Timestamptz
  validTo       DateTime?    @map("valid_to") @db.Timestamptz

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([priceListId, variantId])
  @@map("price_rules")
}

enum DiscountType {
  pct
  fixed_off
  fixed_price
}

// ────────────────────────── Inventory ──────────────────────────

model Warehouse {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique @db.VarChar(24)
  region    String  @db.Char(2)
  name      String  @db.VarChar(120)
  isActive  Boolean @default(true) @map("is_active")

  levels InventoryLevel[]

  @@map("warehouses")
}

model InventoryLevel {
  warehouseId  String   @map("warehouse_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  onHand       Int      @default(0) @map("on_hand")
  reserved     Int      @default(0)
  reorderPoint Int      @default(0) @map("reorder_point")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([warehouseId, variantId])
  @@map("inventory_levels")
}

// ────────────────────────── Cart / Orders ──────────────────────────

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  businessId String?  @unique @map("business_id") @db.Uuid
  region     String   @db.Char(2)
  currency   String   @db.Char(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  business BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @map("cart_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  qty        Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(14, 4)
  currency   String   @db.Char(3)
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                  String   @id @default(uuid()) @db.Uuid
  orderNumber         String   @unique @map("order_number") @db.VarChar(20)
  userId              String?  @map("user_id") @db.Uuid
  businessId          String?  @map("business_id") @db.Uuid
  channel             OrderChannel
  region              String   @db.Char(2)
  currency            String   @db.Char(3)
  subtotal            Decimal  @db.Decimal(14, 2)
  discountTotal       Decimal  @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal            Decimal  @default(0) @map("tax_total") @db.Decimal(14, 2)
  shippingTotal       Decimal  @default(0) @map("shipping_total") @db.Decimal(14, 2)
  grandTotal          Decimal  @map("grand_total") @db.Decimal(14, 2)
  status              OrderStatus
  paymentStatus       PaymentStatus @map("payment_status")
  fulfillmentStatus   String   @default("unfulfilled") @map("fulfillment_status") @db.VarChar(40)
  billingAddressId    String?  @map("billing_address_id") @db.Uuid
  shippingAddressId   String?  @map("shipping_address_id") @db.Uuid
  placedAt            DateTime @default(now()) @map("placed_at") @db.Timestamptz
  notes               String?
  metadata            Json     @default("{}") @db.JsonB

  user            User?            @relation(fields: [userId], references: [id])
  business        BusinessProfile? @relation(fields: [businessId], references: [id])
  items           OrderItem[]
  billingAddress  Address?         @relation("OrderBilling",  fields: [billingAddressId],  references: [id])
  shippingAddress Address?         @relation("OrderShipping", fields: [shippingAddressId], references: [id])
  statusHistory   OrderStatusHistory[]

  @@index([userId, placedAt(sort: Desc)])
  @@index([businessId, placedAt(sort: Desc)])
  @@index([status, region])
  @@map("orders")
}

enum OrderChannel {
  d2c
  b2b
  pl
}

enum OrderStatus {
  pending_payment
  paid
  processing
  partially_shipped
  shipped
  delivered
  cancelled
  refunded
  on_hold
}

enum PaymentStatus {
  unpaid
  authorized
  paid
  partially_refunded
  refunded
  failed
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  sku            String  @db.VarChar(64)
  name           String  @db.VarChar(200)
  qty            Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(14, 4)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         BigInt   @id @default(autoincrement())
  orderId    String   @map("order_id") @db.Uuid
  fromStatus String?  @map("from_status") @db.VarChar(40)
  toStatus   String   @map("to_status") @db.VarChar(40)
  actorId    String?  @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt(sort: Desc)])
  @@map("order_status_history")
}

// ────────────────────────── RFQ ──────────────────────────

model Rfq {
  id             String   @id @default(uuid()) @db.Uuid
  rfqNumber      String   @unique @map("rfq_number") @db.VarChar(20)
  businessId     String   @map("business_id") @db.Uuid
  createdById    String?  @map("created_by") @db.Uuid
  region         String   @db.Char(2)
  currency       String   @db.Char(3)
  incoterm       String?  @db.VarChar(12)
  requestedBy    DateTime? @map("requested_by") @db.Date
  notes          String?
  status         RfqStatus
  assignedToId   String?  @map("assigned_to") @db.Uuid
  submittedAt    DateTime @default(now()) @map("submitted_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  business BusinessProfile @relation(fields: [businessId], references: [id])
  createdBy User?          @relation(fields: [createdById], references: [id])
  items    RfqItem[]
  quotes   Quote[]

  @@map("rfqs")
}

enum RfqStatus {
  submitted
  under_review
  quoted
  revised
  accepted
  rejected
  expired
}

model RfqItem {
  id                String  @id @default(uuid()) @db.Uuid
  rfqId             String  @map("rfq_id") @db.Uuid
  variantId         String? @map("variant_id") @db.Uuid
  customDescription String? @map("custom_description")
  qty               Int
  targetPrice       Decimal? @map("target_price") @db.Decimal(14, 4)

  rfq     Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("rfq_items")
}

model Quote {
  id          String   @id @default(uuid()) @db.Uuid
  rfqId       String   @map("rfq_id") @db.Uuid
  version     Int      @default(1)
  currency    String   @db.Char(3)
  subtotal    Decimal? @db.Decimal(14, 2)
  shipping    Decimal? @db.Decimal(14, 2)
  tax         Decimal? @db.Decimal(14, 2)
  grandTotal  Decimal? @map("grand_total") @db.Decimal(14, 2)
  validUntil  DateTime? @map("valid_until") @db.Date
  terms       String?
  status      QuoteStatus
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rfq   Rfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  items QuoteItem[]

  @@unique([rfqId, version])
  @@map("quotes")
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  superseded
}

model QuoteItem {
  id        String  @id @default(uuid()) @db.Uuid
  quoteId   String  @map("quote_id") @db.Uuid
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 4)
  qty       Int
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

// ────────────────────────── Private Label ──────────────────────────

model PrivateLabelRequest {
  id                     String   @id @default(uuid()) @db.Uuid
  plNumber               String   @unique @map("pl_number") @db.VarChar(20)
  businessId             String?  @map("business_id") @db.Uuid
  createdById            String?  @map("created_by") @db.Uuid
  brandName              String?  @map("brand_name") @db.VarChar(120)
  targetRegions          String[] @map("target_regions") @db.Char(2)
  estimatedAnnualVolume  Int?     @map("estimated_annual_volume")
  status                 PlStatus
  assignedManagerId      String?  @map("assigned_manager") @db.Uuid
  slaTargetShipDate      DateTime? @map("sla_target_ship_date") @db.Date
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  business  BusinessProfile? @relation(fields: [businessId], references: [id])
  createdBy User?            @relation(fields: [createdById], references: [id])
  files     PlFile[]
  history   PlStatusHistory[]

  @@map("pl_requests")
}

enum PlStatus {
  draft
  submitted
  under_review
  product_selection
  formulation
  packaging_design
  sample_production
  sample_approval
  mass_production
  qc
  shipped
  completed
  cancelled
}

model PlFile {
  id           String   @id @default(uuid()) @db.Uuid
  plRequestId  String   @map("pl_request_id") @db.Uuid
  kind         PlFileKind
  s3Key        String   @map("s3_key") @db.VarChar(500)
  version      Int      @default(1)
  uploadedById String?  @map("uploaded_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz
  approvedById String?  @map("approved_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  request PrivateLabelRequest @relation(fields: [plRequestId], references: [id], onDelete: Cascade)

  @@map("pl_files")
}

enum PlFileKind {
  logo
  artwork
  spec_sheet
  coa
  sample_photo
  proof
  other
}

model PlStatusHistory {
  id          BigInt   @id @default(autoincrement())
  plRequestId String   @map("pl_request_id") @db.Uuid
  fromStatus  String?  @map("from_status") @db.VarChar(40)
  toStatus    String   @map("to_status") @db.VarChar(40)
  actorId     String?  @map("actor_id") @db.Uuid
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  request PrivateLabelRequest @relation(fields: [plRequestId], references: [id], onDelete: Cascade)

  @@map("pl_status_history")
}

// ────────────────────────── Platform ──────────────────────────

model Region {
  code            String  @id @db.Char(2)
  name            String  @db.VarChar(80)
  defaultCurrency String  @map("default_currency") @db.Char(3)
  defaultLang     String  @default("en") @map("default_lang") @db.Char(2)
  taxModel        TaxModel @map("tax_model")
  isActive        Boolean @default(true) @map("is_active")

  @@map("regions")
}

enum TaxModel {
  vat
  gst
  none
}

model FxRate {
  baseCurrency  String   @map("base_currency") @db.Char(3)
  quoteCurrency String   @map("quote_currency") @db.Char(3)
  rate          Decimal  @db.Decimal(16, 8)
  asOfDate      DateTime @map("as_of_date") @db.Date

  @@id([baseCurrency, quoteCurrency, asOfDate])
  @@map("fx_rates")
}

model OutboxEvent {
  id           BigInt   @id @default(autoincrement())
  aggregate    String   @db.VarChar(40)
  aggregateId  String   @map("aggregate_id") @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(80)
  payload      Json     @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  publishedAt  DateTime? @map("published_at") @db.Timestamptz

  @@index([publishedAt])
  @@map("outbox_events")
}
