# The storefront has no database of its own. Accounts, carts, orders,
# enquiries and emails all live in the API (apps/api) — see the root .env.example.

# Where the browser reaches the API, e.g. https://api.gnsspices.com in production.
# The API's COOKIE_DOMAIN must cover both hosts (e.g. .gnsspices.com) and its
# CORS_ORIGIN must include this site's URL.
NEXT_PUBLIC_API_BASE="http://localhost:4000"

# This site's public URL.
NEXT_PUBLIC_SITE_URL="https://www.gnsspices.com"

# Domain printed inside product QR codes (/labels). Must be the live site.
CODES_BASE_URL="https://www.gnsspices.com"

# ─── Partner strategy portal (unrelated to customer accounts) ─
# GNS_STRATEGY_CODES="partner:RETRO@2026"
# GNS_STRATEGY_SECRET="447e0c38b6ebd88d16be7dc0b60aa7604752322d01dad51edfdd2bee772b61c1"
