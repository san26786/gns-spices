# ─── Required for auth ───────────────────────────────────────────

# Postgres connection string. Provision via Vercel dashboard:
# https://vercel.com/dashboard → storefront project → Storage → Create → Postgres
# Vercel will inject POSTGRES_URL (and its pooled variant); alias it to DATABASE_URL below.
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# 32+ char random string used to HMAC-sign session cookies.
# Generate locally with:  openssl rand -hex 32
AUTH_SECRET="change-me-in-vercel-dashboard-32-hex-chars-minimum-please"

# Resend API key. Sign up at https://resend.com, verify gnsspices.com domain
# (they'll give you SPF/DKIM DNS records to add), then create an API key.
RESEND_API_KEY="re_XXXXXXXXXXXXXXXX"

# ─── Optional overrides ──────────────────────────────────────────

# The site URL used in email links. Defaults to https://www.gnsspices.com
# in production, but override for staging / preview deployments.
NEXT_PUBLIC_SITE_URL="https://www.gnsspices.com"

# The From header on outbound email. Must be an address on a domain
# verified in Resend.
MAIL_FROM="GNS Spices <no-reply@gnsspices.com>"

# ─── Existing (partner strategy portal — unrelated to user auth) ─
# GNS_STRATEGY_CODES="partner:RETRO@2026"
# GNS_STRATEGY_SECRET="447e0c38b6ebd88d16be7dc0b60aa7604752322d01dad51edfdd2bee772b61c1"

# Domain printed inside product QR codes (/labels). Must be the live site.
CODES_BASE_URL="https://www.gnsspices.com"
