# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://gns:gns@localhost:5432/gns?schema=public"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ─────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-32-byte-random-string-dev-only
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-string
JWT_REFRESH_TTL_SEC=2592000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ─── Storefront ──────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_DEFAULT_REGION=GB
